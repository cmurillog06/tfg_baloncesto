# ==============================================================================
# VARIABLES DE ENTORNO (PLANTILLA .env.example)
# ==============================================================================

# Entorno de ejecución: 'config.settings.local' o 'config.settings.production'
DJANGO_SETTINGS_MODULE=config.settings.local

# Clave secreta de Django (Generar una aleatoria y segura para producción)
SECRET_KEY=django-insecure-tfg-baloncesto-dev-secret-key-change-in-prod

# Modo depuración (True en local, False en producción)
DEBUG=True

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de datos (Dejar vacío o comentar para usar SQLite en local; o especificar URL)
# DATABASE_URL=postgres://user:password@localhost:5432/tfg_baloncesto_db

# Redis Channel Layer para WebSockets (Opcional en local: usa InMemoryChannelLayer por defecto si no está definido)
# REDIS_URL=redis://127.0.0.1:6379/0
